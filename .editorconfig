# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = crlf
# Ensure all files trail with a final newline
insert_final_newline = true
# Trims whitespace before line breaks only (does not remove final newline)
trim_trailing_whitespace = true

[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true

[*.{ts,tsx,html}]
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true

[*.{txt,md}]
insert_final_newline = true
trim_trailing_whitespace = true
