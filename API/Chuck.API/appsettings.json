{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ChuckSettings": {
    "MaxPayloadSizeBytes": 524288000,
    "RamThresholdBytes": 51200,
    "MaxRamCacheSizeBytes": 104857600,
    "DiskStoragePath": "/app/data/drops",
    "EnableVirusScanning": true,
    "ClamAvHost": "clamav",
    "ClamAvPort": 3310,
    "InstancePasscodes": ""
  }
}
