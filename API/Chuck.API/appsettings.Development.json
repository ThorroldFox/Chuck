{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ChuckSettings": {
    "MaxPayloadSizeBytes": 524288000,
    "RamThresholdBytes": 51200,
